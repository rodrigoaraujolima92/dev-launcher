# Binario compilado (o start-ui.ps1 recompila quando precisa)
dev-launcher.exe
*.exe

# Saidas de execucao
*.log
tmp/

# Configuracao de cada um: projetos, pastas e rede docker da maquina de quem usa. O
# launcher cria um config.json vazio na primeira execucao.
config.json
start-dev.ps1

# Tarefas e estacoes de lofi da aba foco: tambem sao de cada um
foco.json

# Sobra de escrita atomica (salvarConfig/salvarFoco gravam .tmp e renomeiam)
config.json.tmp
foco.json.tmp

# Atalho do Windows: guarda caminho absoluto da maquina de quem criou
*.lnk
